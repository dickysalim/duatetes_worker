#!/bin/sh
# Run wrangler with auth isolated to this project (duatetes account).
# HOME is redirected so wrangler never touches ~/.wrangler (other account).
# Credentials come from ../tokens/tokens.env (CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID).
DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$DIR/../tokens/tokens.env"
export HOME="$DIR/.cf-home"
unset CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID CF_API_TOKEN XDG_CONFIG_HOME
if [ -f "$ENV_FILE" ]; then
  set -a; . "$ENV_FILE"; set +a
fi
[ -z "$CLOUDFLARE_API_TOKEN" ] && unset CLOUDFLARE_API_TOKEN
[ -z "$CLOUDFLARE_ACCOUNT_ID" ] && unset CLOUDFLARE_ACCOUNT_ID
exec "$DIR/node_modules/.bin/wrangler" "$@"
